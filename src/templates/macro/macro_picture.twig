{% macro picture(classes, source, alt, width, height, position=0) %}
    <picture>
        <source srcset="/src/assets/images/{{ source }}?format=webp" type="image/webp" width="{{ width }}"
                height="{{ height }}" />
        <source srcset="/src/assets/images/{{ source }}?format=avif" type="image/avif" width="{{ width }}"
                height="{{ height }}" />
        <img class="{{ classes }}"
             style="transform: translateY({{ position > 0 ? '-'~position ~ 'px' : 0 }});"
             src="/src/assets/images/{{ source }}"
             alt="{{ alt }}"
             loading="lazy"
             decoding="async"
             width="{{ width }}" height="{{ height }}" />
    </picture>
{% endmacro %}