<div class="form-field">
    <label for="{{ field.name }}" class="form-field__label">
        {{ field.label }}
    </label>

    {% if field.icon != "" %}
    {{ icon("form-field__icon", field.icon, 20, 20) }}
    {% endif %}

    <input class="form-field__element{% if field.icon != "" %} form-field__element--with-icon {% endif %}"
        name="{{ field.name }}" id="{{ field.name }}" type="{{ field.type }}"
        placeholder="{{ field.placeholder }}" {% if field.pattern %} pattern="{{ field.pattern }}" {% endif %} {% if
        field.required==true %} required {% endif %} />
</div>