<div class="form-field{{ modificator ? " form-field--" ~ modificator }}">

    <label for="{{ field.name }}" class="form-field__label{% if not field.label %} form-field__label--empty{% endif %}">
        {{ field.label }}
    </label>

    {% if field.icon %}
        {{ icon("form-field__icon", field.icon, 20, 20) }}
    {% endif %}

    <input class="form-field__element{{ field.icon ? " form-field__element--with-icon" }}{{ modificator ? " form-field__element--" ~ modificator }}"
           name="{{ field.name }}" id="{{ field.name }}" type="{{ field.type }}"
           placeholder="{{ field.placeholder }}"
            {% if field.pattern %} pattern="{{ field.pattern }}" {% endif %}
            {% if field.required==true %} required {% endif %} />
</div>