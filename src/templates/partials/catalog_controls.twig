{% from '../macro/icon.twig' import icon %}
<form action="/search_catalog" method="get" class="catalog-controls">

    <div class="catalog-controls__header">

        <h2 class="catalog-controls__title">{{ catalog.hero.subtitle }}</h2>

        <div class="catalog-controls__elements">
            <div class="catalog-controls__select form-field">
                <label>
                    <select name="{{ catalog.controls.select.name }}" id="{{ catalog.controls.select.id }}"
                            class="select form-field__element">
                        {% for option in catalog.controls.select.options %}
                            <option value="{{ option.value }}">{{ option.text }}</option>
                        {% endfor %}
                    </select>
                    <span class="form-field__icon form-field__icon--arrow"></span>
                </label>
            </div>

            <div class="catalog-controls__search">
                {% include "ui/form/input.twig" with {field: catalog.controls.search, modificator: "catalog-search"} %}
            </div>

            <button type="submit" hidden></button>
        </div>

    </div>

    <ul class="catalog-controls__tag-list">
        {% for tag in catalog.tags %}
            <li class="catalog-controls__tag">
                <button class="button button--primary button--large" type="button">
                    {{ tag }}
                    {{ icon("button__icon button__icon--right", "delete", 16, 16) }}
                </button>
            </li>
        {% endfor %}
        <li class="catalog-controls__tag">
            <button class="button button--tertiary button--large" type="reset">
                {{ catalog.tags_clear }}
            </button>
        </li>
    </ul>

</form>