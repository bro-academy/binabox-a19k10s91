{% from '../macro/icon.twig' import icon %}
<header class="header">
    <div class="content-wrapper header__wrapper">

        <button class="button button--primary button--small burger">
            <span class="burger__line"></span>
            <span class="burger__line"></span>
            <span class="burger__line"></span>
        </button>

        <a class="header__brand" href="/">
            <svg class="icon header__logo" width="36" height="40">
                <use href="/src/assets/icons/graph_logo.svg" />
            </svg>
            <svg class="icon header__logo-name" width="134" height="21">
                <use href="/src/assets/icons/binabox.svg" />
            </svg>
        </a>

        <div class="header__menu">
            <nav class="header__nav">
                <ul class="header__nav-list">
                    {% for link in header.links %}
                        <li>
                            <a class="link link--tertiary header__nav-item{% if link.active %} header__nav-item--active{% endif %}"
                               href="{{ link.href }}">
                                {{ link.label }}
                                {{ icon("header__nav-icon", "down", 24, 24) }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            <form action="/search" method="get" class="header__search header__search--separator_right">
                {% include "ui/form/input.twig" with {field: header.search, modificator: "search"} %}
                <button type="submit" hidden></button>
            </form>
        </div>

        <div class="header__user-nav">
            <a href="#" class="button button--primary button--large header__user-button">
                <span class="button__text button__text tablet-hidden mobile-hidden">{{ header.default_button.text }}</span>
                {{ icon("button__icon button__icon--left header__nav-icon-login", "discord", 24, 24) }}
            </a>
            <a href="#" class="button button--secondary button--large header__user-button">
                <span class="button__text mobile-hidden">{{ header.primary_button.text }}</span>
                {{ icon( "button__icon button__icon--left header__nav-icon-login", "men", 24, 24) }}
            </a>
        </div>

    </div>
</header>