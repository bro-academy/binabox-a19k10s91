{% from '../macro/macro_picture.twig' import picture %}
{% from '../macro/icon.twig' import icon %}
    {{ picture(
        'personal-card__picture',
        member.image,
        member.image_alt,
        120,
        120
    ) }}
<p class="personal-card__name"><strong>{{ member.name }}</strong></p>
<p class="personal-card__position">{{ member.position }}</p>
<ul class="personal-card__social-list social-list">
    {% for social in member.social %}
        <li class="social-list__item">
            <a class="social-list__link" href="{{ social.link }}">
                {{ icon("social-list__logo", social.icon, 24,24) }}
                {# <img class="social-list__personal-icon" src="{{ social.icon }}" alt="{{ social.alt }}"> #}
            </a>
        </li>
    {% endfor %}
</ul>
