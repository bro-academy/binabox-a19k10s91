{% from '../../macro/icon.twig' import icon %}
<form method="post" action="/send" class="contact-form">
     <h2 class="contact-form__title">{{ contact.form.title }}</h2>
     <p class="contact-form__subtitle">{{ contact.form.subtitle }}</p>

    <div class="contact-form__wrapper">
    {% for field in contact.form.fields %}
          {% if field.type == "radio" %}
               {% include "../ui/form/radio_set.twig" %}
          {% elseif field.type == "textarea" %}
               {% include "../ui/form/textarea.twig" %}
          {% else %}
               {% include "../ui/form/input.twig" %}
          {% endif %}
     {% endfor %}

     {% include "../ui/form/checkbox.twig" with { field: contact.form.submit, option: contact.form.submit.option } %}

     <button type="submit" class="contact-form__button button button--secondary button--large">
          {{ contact.form.submit.button }}
     </button>
    </div>


</form>