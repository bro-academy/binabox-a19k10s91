{% from '../macro/icon.twig' import icon %}
<section class="catalog-content">
    <h2 class="catalog-content__title">{{ catalog.hero.subtitle }}</h2>
        <ul>
            {% for tag in catalog.tags %}
            <li>
                <button class="button button--primary button--large">
                    <p class="button__content">
                        {{ tag }}
                        {{ icon("catalog-content__tag-delete", "delete", 16, 16) }}
                    </p>
                </button>
            </li>
            {% endfor %}
            <li>
                <button class="button button--tertiary button--large">
                    {{ catalog.tags_clear }}
                </button>
            </li>
        </ul>
    <div>
        {% for item in catalog.items %}
        {% include 'catalog_item.twig' %}
        {% endfor %}
    </div>
    <a class="button button--primary button--large" href="#">
            {{ catalog.button_load }}
    </a>
</section>